# ---- Deriv credentials ----
# NEW developers.deriv.com OAuth/web apps use alphanumeric App IDs (auto v2 mode).
# LEGACY numeric App IDs (e.g. 1089) use classic WebSocket authorize.
DERIV_APP_ID=33R2Z6MTElnIWrId8aH3m
# PAT or OAuth access_token (Bearer). For OAuth web apps prefer /oauth/login on Cloud Run.
DERIV_API_TOKEN=your_pat_or_access_token_here
# Optional: pin options account id (e.g. VRTC…)
# DERIV_ACCOUNT_ID=
# auto | legacy | v2
DERIV_API_MODE=auto
DERIV_API_BASE=https://api.derivws.com
# OAuth redirect (must match developers.deriv.com app settings)
DERIV_OAUTH_REDIRECT_URI=https://deriv-ai-bot-842806243906.us-central1.run.app/oauth/callback
# DERIV_OAUTH_CLIENT_SECRET=   # if your app issues a secret

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# demo | real
MODE=demo
# Focused learning portfolio (winners-aligned; must exist in strategy.xml)
# Prefer fewer symbols so samples concentrate: R_25,R_50,1HZ50V,R_10
SYMBOLS=R_25,R_50,1HZ50V,R_10

# true = proposal+buy; false = proposal only (paper). Real mode defaults to false.
EXECUTE_TRADES=true
# Digit contract length in ticks
TRADE_DURATION_TICKS=5

# Risk / money management
MIN_BALANCE=1.0
MAX_OPEN_TRADES=3
# Risk 1–2% of balance per trade
MAX_STAKE_PCT=1.5
MIN_STAKE=0.35
BASE_STAKE=1.0
# Optional hard stake ceiling (account currency). Leave empty for % only.
# MAX_STAKE=10

# Session run: stop-loss 5–10% of start balance; target = stop_loss_amount × RR (1:3)
SESSION_STOP_LOSS_PCT=5.0
SESSION_STOP_LOSS_PCT_MIN=5.0
SESSION_STOP_LOSS_PCT_MAX=10.0
SESSION_TARGET_RR=3.0
SESSION_STOP_ON_TARGET=true

# Analytics gate: require Pattern≥75, Live Edge≥80, Quality≥80 (bootstrap softens when n small)
ANALYTICS_GATE=true

# DeepSeek advisor (trade-type analysis + learning multipliers)
# Get a key at https://platform.deepseek.com/api_keys
# MUST start with sk-  (NOT a Google AIzaSy… key — Secret Manager had the wrong one)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Auto-analyze every N closed trades (0 = dashboard only)
DEEPSEEK_ANALYZE_EVERY=5
# DEEPSEEK_ENABLED=true

# Learning durability on Cloud Run (optional — ephemeral disk without this)
# LEARNING_GCS_URI=gs://YOUR_BUCKET/deriv-bot/learning/
# COLD_START_EXIT_N=50
# MATURE_SAMPLE_N=100

# Tick history bootstrap on connect (AI warmup)
TICK_HISTORY_COUNT=500
TICK_HISTORY_MIN=50
SAVE_TICK_HISTORY=true

# Model training quality gates
MIN_MODEL_ACCURACY=0.12
MIN_MODEL_LIFT=0.0
FORCE_SAVE_MODEL=false
TRAIN_LSTM=false

# Cloud Run / container
# PORT is set automatically by Cloud Run (default 8080)
# TRADE_CYCLE_SECONDS=60
# On Cloud Run set SAVE_TICK_HISTORY=false (disk is ephemeral)
