<configroot>
    <!--
      Digits portfolio: OVER@6 (digits 7-9) and UNDER@4 (digits 0-3).
      Martingale recovery + global risk caps protect the account.
    -->
    <global>
        <min_confidence>0.72</min_confidence>
        <max_daily_loss_pct>5.0</max_daily_loss_pct>
        <max_consecutive_losses>5</max_consecutive_losses>
        <trade_pause_minutes>60</trade_pause_minutes>
    </global>

    <!-- Volatility indices — diversified last-digit markets -->
    <market symbol="R_10">
        <strategy type="martingale">
            <base_stake>1.0</base_stake>
            <max_steps>5</max_steps>
            <over_barrier>6</over_barrier>
            <under_barrier>4</under_barrier>
            <duration>5</duration>
            <duration_unit>t</duration_unit>
            <contract_types>
                <type>DIGITOVER</type>
                <type>DIGITUNDER</type>
            </contract_types>
        </strategy>
    </market>

