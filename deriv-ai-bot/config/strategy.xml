<configroot>
    <!--
      Portfolio: classic volatilities + 1-second (1Hz) indices.
      Digits: OVER@6, UNDER@4, EVEN, ODD
      Rise/Fall: CALL / PUT (trend + EMA/RSI/MACD/structure)
      min_confidence: raise/lower ONLY here (e.g. 0.75–0.85). Default 0.80.
      Adaptive learner re-weights markets after every closed trade.
    -->
    <global>
        <!-- Raise/lower trade gate here only (e.g. 0.75 or 0.85) -->
        <min_confidence>0.82</min_confidence>
        <!-- flat = never double after loss (recommended). martingale = optional. -->
        <stake_mode>flat</stake_mode>
        <!-- Tighter daily loss: stop digging when demo is bleeding -->
        <max_daily_loss_pct>2.0</max_daily_loss_pct>
        <!-- After this many losses in a row, pause (protects account) -->
        <max_consecutive_losses>3</max_consecutive_losses>
        <trade_pause_minutes>30</trade_pause_minutes>
    </global>

