<configroot>
    <!--
      Portfolio: classic volatilities + 1-second (1Hz) indices.
      Digits: OVER@6, UNDER@4, EVEN, ODD
      Rise/Fall: CALL / PUT (trend + EMA/RSI/MACD/structure)
      min_confidence: raise/lower ONLY here (e.g. 0.75–0.85). Default 0.80.
      Adaptive learner re-weights markets after every closed trade.
    -->
    <global>
        <!-- Bootstrap: 0.72 while cold; raise toward 0.80 once mature samples exist -->
        <min_confidence>0.72</min_confidence>
        <!-- flat = never double after loss (recommended). martingale = optional. -->
        <stake_mode>flat</stake_mode>
        <!-- Session stop-loss % of start balance (band 5–10; UI can raise within band) -->
        <max_daily_loss_pct>5.0</max_daily_loss_pct>
        <session_stop_loss_pct>5.0</session_stop_loss_pct>
        <!-- Profit target = stop_loss_amount × RR (standard 1:3) -->
        <session_target_rr>3.0</session_target_rr>
        <!-- After this many losses in a row, pause (protects account) -->
        <max_consecutive_losses>3</max_consecutive_losses>
        <!-- Smart stop: shorter cool-down after consecutive losses / strategy failure -->
        <trade_pause_minutes>10</trade_pause_minutes>
    </global>

